# Konfigurasi Docker Compose
# Salin file ini menjadi .env lalu sesuaikan nilainya.

# --- Database MySQL 8 ---
# Root password hanya dipakai oleh mysqladmin untuk healthcheck di dalam container.
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=project_ai
MYSQL_USER=app
MYSQL_PASSWORD=app
# Port MySQL di host (backend terhubung lewat jaringan internal Docker)
DB_PORT=3307

# --- Keamanan ---
# WAJIB diganti dengan rahasia acak yang panjang di produksi
JWT_SECRET=ganti-dengan-rahasia-acak-yang-panjang
JWT_EXPIRES_IN=12h

# Seed data demo (hanya untuk pengembangan/demo). Bawaan: false (pakai data nyata).
SEED_DEMO=false

# Akun admin pertama. Dibuat otomatis hanya bila belum ada pengguna sama sekali.
# WAJIB ganti password bawaan sebelum dipakai sungguhan.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin123!

# --- Port layanan di host ---
# Frontend diakses lewat http://localhost:8090
FRONTEND_PORT=8090
# Backend API diakses langsung lewat http://localhost:3000 (opsional)
BACKEND_PORT=3000

# Catatan: model Machine Learning berjalan di browser (client-side).
# Tidak ada container/layanan ML terpisah yang perlu dijalankan di VPS.

# Origin yang diizinkan untuk CORS (frontend diakses lewat nginx sehingga same-origin)
CORS_ORIGIN=*

# Set true hanya bila aplikasi diakses melalui HTTPS
COOKIE_SECURE=false
